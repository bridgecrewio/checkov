{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "emailAccountAdmins": {
      "type": "bool"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2014-04-01",
      "name": "sqlserver/admins-enabled",
      "location": "westeurope",
      "resources": [
        {
          "type": "securityAlertPolicies",
          "apiVersion": "2014-04-01",
          "name": "default",
          "properties": {
            "state": "Enabled",
            "emailAccountAdmins": "Enabled",
            "emailAddresses": "secops@example.com"
          }
        }
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "sqlserver/admins-true",
      "location": "westeurope",
      "resources": [
        {
          "type": "securityAlertPolicies",
          "apiVersion": "2023-08-01",
          "name": "Default",
          "properties": {
            "state": "Enabled",
            "emailAccountAdmins": true,
            "emailAddresses": ["secops@example.com"]
          }
        }
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2014-04-01",
      "name": "sqlserver/admins-disabled",
      "location": "westeurope",
      "resources": [
        {
          "type": "securityAlertPolicies",
          "apiVersion": "2014-04-01",
          "name": "default",
          "properties": {
            "state": "Enabled",
            "emailAccountAdmins": "Disabled",
            "emailAddresses": "secops@example.com"
          }
        }
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "sqlserver/admins-false",
      "location": "westeurope",
      "resources": [
        {
          "type": "securityAlertPolicies",
          "apiVersion": "2023-08-01",
          "name": "Default",
          "properties": {
            "state": "Enabled",
            "emailAccountAdmins": false,
            "emailAddresses": ["secops@example.com"]
          }
        }
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "sqlserver/admins-parameter",
      "location": "westeurope",
      "resources": [
        {
          "type": "securityAlertPolicies",
          "apiVersion": "2023-08-01",
          "name": "Default",
          "properties": {
            "state": "Enabled",
            "emailAccountAdmins": "[parameters('emailAccountAdmins')]",
            "emailAddresses": ["secops@example.com"]
          }
        }
      ]
    }
  ]
}
